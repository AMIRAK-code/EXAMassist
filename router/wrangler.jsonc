// The router Worker in front of uniexamer.com (docs/SPLIT-HOSTING.md, router/worker.ts).
// Deployed only by scripts/split-deploy.ts, which fills .router/assets and passes
// VERCEL_ORIGIN. Secrets (wrangler secret put -c router/wrangler.jsonc):
//   ROUTER_SECRET   the same value as ROUTER_SECRET on Vercel
//   VERCEL_BYPASS   Vercel's Protection Bypass for Automation secret, if protection is on
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "examer-router",
  "account_id": "6238aef0224c48ee73d9dfb95fd63796",
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  // Every request that matches a file here is answered before the Worker runs:
  // the public pages, their scripts and styles, and public/. Only misses run it.
  "assets": {
    "directory": "../.router/assets",
    "html_handling": "auto-trailing-slash"
  },
  // Pricing, checkout and the account: the OpenNext Worker, which holds the Stripe keys.
  "services": [{ "binding": "EXAMER", "service": "examer" }],
  "routes": [
    { "pattern": "uniexamer.com", "custom_domain": true },
    { "pattern": "www.uniexamer.com", "custom_domain": true },
    { "pattern": "exam.assist365.app", "custom_domain": true }
  ],
  "workers_dev": false,
  // `--upload` makes a version with its own address and no traffic, to try a release first.
  "preview_urls": true,
  "observability": { "enabled": true }
}

// Cloudflare Workers deployment of the site at https://uniexamer.com.
// Build and deploy with `npm run cf:deploy` (see open-next.config.ts).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "examer",
  // The account that holds the uniexamer.com and assist365.app zones.
  "account_id": "6238aef0224c48ee73d9dfb95fd63796",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // A request that matches a file here is answered before the Worker runs. That
  // includes the public pages `npm run cf:deploy` saves (scripts/snapshot-pages.ts):
  // /exams/gmat is exams/gmat.html and / is index.html, with no redirect.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash"
  },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "examer" }],
  // Cloudflare creates and maintains the DNS records and certificates for these.
  // Only uniexamer.com serves pages: www and the old address exam.assist365.app
  // stay attached so next.config.ts can redirect them there.
  "routes": [
    { "pattern": "uniexamer.com", "custom_domain": true },
    { "pattern": "www.uniexamer.com", "custom_domain": true },
    { "pattern": "exam.assist365.app", "custom_domain": true }
  ],
  "workers_dev": false,
  // Each uploaded version gets its own <version>-examer.<subdomain>.workers.dev
  // address, which no visitor is sent to: `npm run cf:deploy` saves the public
  // pages from there before it moves traffic (scripts/cloudflare.ts).
  "preview_urls": true,
  // examer-db: the examer_app login against the Supabase session pooler (port
  // 5432), TLS verify-full against the Supabase root CA, and query caching off
  // because the app always needs its own latest writes. Not the transaction
  // pooler (6543): under Hyperdrive's own pooling, connections got stuck "still
  // in a transaction" and requests failed.
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "59bdc939a4c04798918628c36b6e1a2d" }],
  // Public settings. SESSION_SECRET is a Worker secret (wrangler secret put).
  // NEXT_PUBLIC_* values are inlined at build time, so the build sets them too.
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://uniexamer.com",
    // Production is the one deployment search engines may index (canonical
    // https://uniexamer.com). Previews and the Vercel backup keep "false".
    "SEARCH_INDEXING_ENABLED": "true"
  },
  "observability": { "enabled": true }
}

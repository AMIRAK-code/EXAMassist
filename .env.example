# --- Database and session configuration ---------------------------------------------------------------
# Supabase transaction-pooler URL. Required on Vercel; server-only secret.
# Keep empty to use local SQLite. Do not expose as NEXT_PUBLIC_.
DATABASE_URL=

# Local SQLite fallback (relative paths resolve from the repo root).
DATABASE_PATH=./tmp/examer.db

# Secret used to sign/derive session identifiers, and the key email codes are
# hashed with (rotating it voids any code still in flight). MUST be at least 32
# characters; the placeholder below is refused in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-value-at-least-32-chars

# --- Optional ---------------------------------------------------------------
# Optional public Supabase API client; application data uses DATABASE_URL.
# Copy these into .env.local and use the project's Connect dialog values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Absolute public base URL, used for canonical URLs, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "true" to allow search engines to index this deployment.
# Any value other than "true" emits a site-wide noindex + a robots.txt that
# disallows everything. Keep it false for staging/preview deployments.
SEARCH_INDEXING_ENABLED=false

# Google Search Console HTML-tag verification (optional). Paste the token from
# the tag Search Console gives you (the whole tag also works). Emitted on the
# home page as <meta name="google-site-verification"> only when indexing is on.
# Not needed if the property is verified by DNS.
GOOGLE_SITE_VERIFICATION=

# Seed an administrator account on `npm run db:seed` (optional).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Optional: email codes (Brevo) -------------------------------------------
# Sign-in codes, password reset and address confirmation (migration 009). With
# no key, development prints each email to the server console and production
# hides these features entirely. Create the key in Brevo under SMTP & API ->
# API keys, authenticate your domain there, and switch OFF Security ->
# Authorised IPs: Vercel sends from changing addresses, which Brevo would block.
BREVO_API_KEY=
# A sender address on the domain you authenticated in Brevo.
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=UniExamer
# How long to wait for Brevo before giving up (milliseconds).
EMAIL_TIMEOUT_MS=10000

# --- Optional: AI tutor ------------------------------------------------------
# The AI tutor (hints, deeper explanations, after-test guides) is OFF unless
# this key is set. Core practice never depends on it. The key is read only on
# the server and is never sent to the browser. Create one at
# https://console.anthropic.com and keep it out of version control.
ANTHROPIC_API_KEY=

# Set to "false" to switch the tutor off without removing the key.
TUTOR_ENABLED=true

# Model. Defaults to Claude Haiku 4.5.
TUTOR_MODEL=claude-haiku-4-5

# Model calls per UTC day. Cached responses are free and do not count.
TUTOR_ACCOUNT_DAILY_LIMIT=30
TUTOR_GUEST_DAILY_LIMIT=10
# A site-wide ceiling: the spending brake.
TUTOR_GLOBAL_DAILY_LIMIT=500
# How long a learner waits before the tutor gives up (milliseconds).
TUTOR_TIMEOUT_MS=25000

# --- Paid plans through Stripe (docs/BILLING.md) --------------------------------
# "true" turns the paywall on: practice, timed sections, simulations, study
# plans and the AI tutor then need a plan (src/lib/billing/plans.ts). Anything
# else, including empty, keeps every feature free as before, so local
# development and the test suites run without Stripe keys. With "true" and any
# of the three Stripe values below missing, the server refuses to start.
BILLING_ENFORCED=false

# Secret key (sk_test_... / sk_live_...) or a restricted key (rk_...) with
# write access to Customers, Subscriptions, SetupIntents and Invoices and read
# access to Prices. Server only: never NEXT_PUBLIC_, never in Git.
STRIPE_SECRET_KEY=
# Publishable key (pk_test_... / pk_live_...), from the same mode as the secret
# key. Sent to the browser for Stripe.js; read at run time, not build time.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Signing secret (whsec_...) of the webhook endpoint
# https://<site>/api/billing/webhook, with the events
# customer.subscription.created, customer.subscription.updated,
# customer.subscription.deleted, invoice.paid and invoice.payment_failed.
# Locally, `stripe listen --forward-to localhost:3000/api/billing/webhook`
# prints one to use instead.
STRIPE_WEBHOOK_SECRET=
# Set to "true" only after Stripe Tax is set up in the dashboard (origin
# address and registrations). Checkout then asks for the buyer's country and
# Stripe works out the VAT inside the (unchanged, VAT-inclusive) price.
STRIPE_AUTOMATIC_TAX=false

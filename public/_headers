# Cloudflare Workers static assets. next.config.ts sets the same security
# headers on everything the Next.js server renders.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000

# Build output is content-hashed, so it can be cached forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# The interface font, fetched by Stripe's card-field iframes so the Payment
# Element matches the site's own fields (src/components/billing/stripe-appearance.ts).
/fonts/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable
